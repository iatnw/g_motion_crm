# ─── App ────────────────────────────────────────────────────────────────────
# development | production
APP_ENV=development
APP_PORT=8080

# Dev: http://localhost:8080  |  Prod: https://api.yourdomain.com
APP_BASE_URL=http://localhost:8080

# Dev: http://localhost:3000  |  Prod: https://app.yourdomain.com
FRONTEND_URL=http://localhost:3000

# Production only — public URL the browser uses to reach the backend
# Dev: http://localhost:8080  |  Prod: https://api.yourdomain.com
BACKEND_URL=http://localhost:8080

# ─── Database ────────────────────────────────────────────────────────────────
# Dev:  postgres://gmotion:password@localhost:5432/gmotion_crm?sslmode=disable
# Prod: postgres://gmotion:password@your-rds-endpoint.us-west-1.rds.amazonaws.com:5432/gmotion_crm?sslmode=require
DATABASE_URL=postgres://gmotion:password@localhost:5432/gmotion_crm?sslmode=disable

# Used by docker-compose.yml for local Postgres container (dev only)
DB_USER=gmotion
DB_PASSWORD=password
DB_NAME=gmotion_crm

# ─── AWS S3 ──────────────────────────────────────────────────────────────────
AWS_REGION=us-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Dev buckets
# S3_BUCKET_DOCUMENTS=gmotion-docs-dev
# S3_BUCKET_BACKUPS=gmotion-backups-dev

# Prod buckets
S3_BUCKET_DOCUMENTS=gmotion-docs-prod
S3_BUCKET_BACKUPS=gmotion-backups-prod

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=
ENCRYPTION_KEY=

TOTP_ISSUER=GMotionCRM

# ─── Tally ───────────────────────────────────────────────────────────────────
# Found in Tally dashboard → your form → Integrations → Webhooks → Signing Secret
TALLY_SIGNING_SECRET=
